# Wird von Vercel automatisch befüllt, wenn KV verknüpft ist:
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Pflicht: selbst setzen — beliebige zufällige Zeichenkette (mind. 32 Zeichen).
# Ohne gültigen JWT_SECRET bleiben Login und Setup absichtlich deaktiviert.
JWT_SECRET=

# SMTP für Wochenbericht-Versand (optional, ohne wird nur die App-Anzeige genutzt):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
